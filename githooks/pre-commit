#!/bin/sh
# Blocks any commit that takes the codebase off-brand or logs a credential.
# Escape hatch for a genuine one-off: git commit --no-verify
node scripts/brand-check.mjs || {
  echo ""
  echo "Commit blocked by brand-check. Fix the violations above, or"
  echo "add a // brand-check-ignore comment if the exception is deliberate."
  exit 1
}
node scripts/secret-log-check.mjs || exit 1

# ESLint errors fail CI, so catch them here. Staged .ts/.tsx only, to keep the
# hook fast; warnings do not block (CI passes with them too).
staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.mjs')
if [ -n "$staged" ]; then
  # shellcheck disable=SC2086
  npx eslint --quiet $staged || {
    echo ""
    echo "Commit blocked by eslint. Fix the errors above (npm run lint)."
    exit 1
  }
fi
